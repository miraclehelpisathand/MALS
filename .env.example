# Public browser configuration only. Do not put passwords, service_role keys,
# Supabase secret keys or provider credentials in Vite variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Task 5 is experimental and must stay false until migrations 011–014, a
# scheduler with external monitoring and security validation are complete.
VITE_CERTIFICATES_ENABLED=false
